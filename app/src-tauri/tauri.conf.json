{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Blind Passcode Generator",
  "mainBinaryName": "blind-passcode-generator",
  "identifier": "com.uncleyam.blindpasscodegenerator",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blind Passcode Generator",
        "width": 760,
        "height": 720,
        "minWidth": 560,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "maximizable": false,
        "backgroundColor": "#161615"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sam Williams",
    "shortDescription": "Set a passcode that you yourself don't know",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
